# Copy to .env and fill in. Never commit .env.

# Claude API key (https://console.anthropic.com). Without it the offline heuristic scorer is used.
ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather, put the token here, write any message to the bot,
# then run `uv run jobradar tg-setup` to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Work.ua / Robota.ua e-mail alerts (optional, see BIBLE.md §4).
# Gmail: IMAP_HOST=imap.gmail.com, IMAP_USER=you@gmail.com, IMAP_PASSWORD=<app password>
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Optional: custom DB location
# JOBRADAR_DB=data/jobradar.sqlite3
