# Copy to .env and fill in. Never commit .env.

# LLM for scoring – fill in ONE of them (or none: then the keyword heuristic is used).
# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Ollama (local, free) needs no key – set scoring.provider: ollama in config.yaml

# Telegram: create a bot with @BotFather, put the token here, write any message to the bot,
# then run `uv run jobradar tg-setup` to get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Work.ua / Robota.ua e-mail alerts (optional, see BIBLE.md §4).
# Gmail: IMAP_HOST=imap.gmail.com, IMAP_USER=you@gmail.com, IMAP_PASSWORD=<app password>
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=

# Optional: custom DB location
# JOBRADAR_DB=data/jobradar.sqlite3
